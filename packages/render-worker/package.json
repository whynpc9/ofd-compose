{
  "name": "@ofd-compose/render-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@ofd-compose/binding-core": "workspace:*",
    "@ofd-compose/document-model": "workspace:*",
    "@ofd-compose/template-compiler": "workspace:*",
    "@ofd-compose/typography-core": "workspace:*",
    "@ofd-compose/media-core": "workspace:*",
    "@ofd-compose/layout-core": "workspace:*",
    "@ofd-compose/layout-ir": "workspace:*"
  },
  "devDependencies": {
    "harfbuzzjs": "1.6.0",
    "vitest": "5.0.0",
    "vite": "8.2.2"
  },
  "tsdown": {
    "dts": false
  }
}
