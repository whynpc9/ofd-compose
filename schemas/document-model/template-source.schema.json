{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofd-compose.local/schemas/document-model/template-source.schema.json",
  "title": "OFD Compose TemplateSource (Document Model v0)",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "revisionId",
    "settings",
    "styles",
    "body"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ofd-compose/document-model@0",
      "type": "string"
    },
    "documentId": {
      "minLength": 1,
      "type": "string"
    },
    "revisionId": {
      "minLength": 1,
      "type": "string"
    },
    "settings": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "locale",
        "timeZone",
        "bindingPolicyVersion"
      ],
      "properties": {
        "locale": {
          "minLength": 2,
          "description": "BCP 47 locale 标签（如 zh-CN）。v0 仅记录；数字/日期格式化为固定不变文化。",
          "type": "string"
        },
        "timeZone": {
          "minLength": 1,
          "description": "IANA 时区（如 Asia/Shanghai、UTC）。带偏移的日期时间值按此时区取字段。",
          "type": "string"
        },
        "bindingPolicyVersion": {
          "description": "绑定策略版本：strict-1（新模板）或 legacy-compat-1（迁移模板，节点级兼容政策）。",
          "anyOf": [
            {
              "const": "strict-1",
              "type": "string"
            },
            {
              "const": "legacy-compat-1",
              "type": "string"
            }
          ]
        }
      }
    },
    "styles": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9._:-]+$": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "fontFamily": {
              "minLength": 1,
              "type": "string"
            },
            "fontSize": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": "boolean"
            },
            "strikethrough": {
              "type": "boolean"
            },
            "color": {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "highlight": {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            }
          }
        }
      }
    },
    "body": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "nodeId",
          "inlines"
        ],
        "properties": {
          "kind": {
            "const": "paragraph",
            "type": "string"
          },
          "nodeId": {
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "styleId": {
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "inlines": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "nodeId",
                    "text"
                  ],
                  "properties": {
                    "kind": {
                      "const": "text",
                      "type": "string"
                    },
                    "nodeId": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$",
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "styleId": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$",
                      "type": "string"
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "nodeId",
                    "bindingId",
                    "expression"
                  ],
                  "properties": {
                    "kind": {
                      "const": "dynamic-text",
                      "type": "string"
                    },
                    "nodeId": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$",
                      "type": "string"
                    },
                    "bindingId": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$",
                      "type": "string"
                    },
                    "expression": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "kind",
                            "text"
                          ],
                          "properties": {
                            "kind": {
                              "const": "legacy",
                              "type": "string"
                            },
                            "text": {
                              "minLength": 1,
                              "type": "string"
                            }
                          }
                        },
                        {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "kind",
                            "source",
                            "steps"
                          ],
                          "properties": {
                            "kind": {
                              "const": "structured",
                              "type": "string"
                            },
                            "source": {
                              "minLength": 1,
                              "type": "string"
                            },
                            "steps": {
                              "type": "array",
                              "items": {
                                "anyOf": [
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "key"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "sort",
                                        "type": "string"
                                      },
                                      "key": {
                                        "minLength": 1,
                                        "type": "string"
                                      },
                                      "direction": {
                                        "anyOf": [
                                          {
                                            "const": "asc",
                                            "type": "string"
                                          },
                                          {
                                            "const": "desc",
                                            "type": "string"
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "count"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "take",
                                        "type": "string"
                                      },
                                      "count": {
                                        "minimum": 0,
                                        "type": "integer"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "first",
                                        "type": "string"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "last",
                                        "type": "string"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "rank"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "nth",
                                        "type": "string"
                                      },
                                      "rank": {
                                        "minimum": 1,
                                        "type": "integer"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "index"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "at",
                                        "type": "string"
                                      },
                                      "index": {
                                        "type": "integer"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "key"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "maxby",
                                        "type": "string"
                                      },
                                      "key": {
                                        "minLength": 1,
                                        "type": "string"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "key"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "minby",
                                        "type": "string"
                                      },
                                      "key": {
                                        "minLength": 1,
                                        "type": "string"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "path"
                                    ],
                                    "properties": {
                                      "op": {
                                        "anyOf": [
                                          {
                                            "const": "get",
                                            "type": "string"
                                          },
                                          {
                                            "const": "pick",
                                            "type": "string"
                                          }
                                        ]
                                      },
                                      "path": {
                                        "minLength": 1,
                                        "type": "string"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "count",
                                        "type": "string"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "whenTrue"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "if",
                                        "type": "string"
                                      },
                                      "whenTrue": {
                                        "type": "string"
                                      },
                                      "whenFalse": {
                                        "type": "string"
                                      }
                                    }
                                  },
                                  {
                                    "additionalProperties": false,
                                    "type": "object",
                                    "required": [
                                      "op",
                                      "kind"
                                    ],
                                    "properties": {
                                      "op": {
                                        "const": "format",
                                        "type": "string"
                                      },
                                      "kind": {
                                        "anyOf": [
                                          {
                                            "const": "number",
                                            "type": "string"
                                          },
                                          {
                                            "const": "numeric",
                                            "type": "string"
                                          },
                                          {
                                            "const": "percent",
                                            "type": "string"
                                          },
                                          {
                                            "const": "percentage",
                                            "type": "string"
                                          },
                                          {
                                            "const": "permille",
                                            "type": "string"
                                          },
                                          {
                                            "const": "per-mille",
                                            "type": "string"
                                          },
                                          {
                                            "const": "per_mille",
                                            "type": "string"
                                          },
                                          {
                                            "const": "date",
                                            "type": "string"
                                          },
                                          {
                                            "const": "datetime",
                                            "type": "string"
                                          },
                                          {
                                            "const": "time",
                                            "type": "string"
                                          }
                                        ]
                                      },
                                      "pattern": {
                                        "type": "string"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          }
                        }
                      ]
                    },
                    "styleId": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$",
                      "type": "string"
                    },
                    "styleInheritance": {
                      "anyOf": [
                        {
                          "const": "inherit-paragraph",
                          "type": "string"
                        },
                        {
                          "const": "explicit",
                          "type": "string"
                        }
                      ]
                    }
                  }
                },
                {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "nodeId",
                    "controlId",
                    "controlType"
                  ],
                  "properties": {
                    "kind": {
                      "const": "input-control",
                      "type": "string"
                    },
                    "nodeId": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$",
                      "type": "string"
                    },
                    "controlId": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$",
                      "type": "string"
                    },
                    "controlType": {
                      "anyOf": [
                        {
                          "const": "text",
                          "type": "string"
                        },
                        {
                          "const": "number",
                          "type": "string"
                        },
                        {
                          "const": "select",
                          "type": "string"
                        },
                        {
                          "const": "date",
                          "type": "string"
                        },
                        {
                          "const": "radio",
                          "type": "string"
                        },
                        {
                          "const": "checkbox",
                          "type": "string"
                        }
                      ]
                    },
                    "placeholder": {
                      "type": "string"
                    },
                    "defaultValue": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "styleId": {
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._:-]+$",
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9._:/-]+$": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "required",
            "data"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "data": {}
          }
        }
      }
    },
    "provenance": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "anyOf": [
            {
              "const": "native",
              "type": "string"
            },
            {
              "const": "legacy-docx-import",
              "type": "string"
            }
          ]
        },
        "templateId": {
          "minLength": 1,
          "type": "string"
        },
        "legacyCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      }
    }
  }
}
