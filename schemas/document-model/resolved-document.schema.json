{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofd-compose.local/schemas/document-model/resolved-document.schema.json",
  "title": "OFD Compose ResolvedDocument v0",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "format",
    "modelVersion",
    "templateSchemaVersion",
    "expressionLanguageVersion",
    "bindingPolicyVersion",
    "documentId",
    "revisionId",
    "settings",
    "styles",
    "body",
    "structure",
    "runtime"
  ],
  "properties": {
    "format": {
      "const": "ofd-compose/resolved-document@0",
      "type": "string"
    },
    "modelVersion": {
      "const": "0",
      "type": "string"
    },
    "templateSchemaVersion": {
      "const": "ofd-compose/document-model@0",
      "type": "string"
    },
    "expressionLanguageVersion": {
      "const": "expr-1",
      "type": "string"
    },
    "bindingPolicyVersion": {
      "description": "绑定策略版本：strict-1（新模板）或 legacy-compat-1（迁移模板，节点级兼容政策）。",
      "anyOf": [
        {
          "const": "strict-1",
          "type": "string"
        },
        {
          "const": "legacy-compat-1",
          "type": "string"
        }
      ]
    },
    "documentId": {
      "minLength": 1,
      "type": "string"
    },
    "revisionId": {
      "minLength": 1,
      "type": "string"
    },
    "settings": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "locale",
        "timeZone",
        "bindingPolicyVersion"
      ],
      "properties": {
        "locale": {
          "minLength": 2,
          "description": "BCP 47 locale 标签（如 zh-CN）。v0 仅记录；数字/日期格式化为固定不变文化。",
          "type": "string"
        },
        "timeZone": {
          "minLength": 1,
          "description": "IANA 时区（如 Asia/Shanghai、UTC）。带偏移的日期时间值按此时区取字段。",
          "type": "string"
        },
        "bindingPolicyVersion": {
          "description": "绑定策略版本：strict-1（新模板）或 legacy-compat-1（迁移模板，节点级兼容政策）。",
          "anyOf": [
            {
              "const": "strict-1",
              "type": "string"
            },
            {
              "const": "legacy-compat-1",
              "type": "string"
            }
          ]
        }
      }
    },
    "styles": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "fontFamily": {
              "minLength": 1,
              "type": "string"
            },
            "fontSize": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": "boolean"
            },
            "strikethrough": {
              "type": "boolean"
            },
            "color": {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            "verticalAlign": {
              "anyOf": [
                {
                  "const": "baseline",
                  "type": "string"
                },
                {
                  "const": "superscript",
                  "type": "string"
                },
                {
                  "const": "subscript",
                  "type": "string"
                }
              ]
            },
            "link": {
              "minLength": 1,
              "type": "string"
            },
            "highlight": {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            }
          }
        }
      }
    },
    "body": {
      "type": "array",
      "items": {
        "$id": "ResolvedBlock",
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "nodeId",
              "fragments"
            ],
            "properties": {
              "kind": {
                "const": "paragraph",
                "type": "string"
              },
              "nodeId": {
                "minLength": 1,
                "type": "string"
              },
              "styleId": {
                "minLength": 1,
                "type": "string"
              },
              "instancePath": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "nodeId",
                    "bindingId",
                    "key",
                    "keyKind",
                    "ordinal"
                  ],
                  "properties": {
                    "nodeId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "bindingId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "keyKind": {
                      "anyOf": [
                        {
                          "const": "path",
                          "type": "string"
                        },
                        {
                          "const": "ordinal",
                          "type": "string"
                        }
                      ]
                    },
                    "ordinal": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "dataPath": {
                      "type": "string"
                    }
                  }
                }
              },
              "layout": {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "role": {
                    "anyOf": [
                      {
                        "const": "body",
                        "type": "string"
                      },
                      {
                        "const": "heading",
                        "type": "string"
                      },
                      {
                        "const": "list-item",
                        "type": "string"
                      }
                    ]
                  },
                  "headingLevel": {
                    "minimum": 1,
                    "maximum": 6,
                    "type": "integer"
                  },
                  "alignment": {
                    "anyOf": [
                      {
                        "const": "left",
                        "type": "string"
                      },
                      {
                        "const": "center",
                        "type": "string"
                      },
                      {
                        "const": "right",
                        "type": "string"
                      },
                      {
                        "const": "justify",
                        "type": "string"
                      }
                    ]
                  },
                  "leftIndent": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "rightIndent": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "firstLineIndent": {
                    "type": "number"
                  },
                  "spaceBefore": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "spaceAfter": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "lineHeight": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "const": "multiple",
                            "type": "string"
                          },
                          "value": {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          }
                        }
                      },
                      {
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "kind",
                          "value"
                        ],
                        "properties": {
                          "kind": {
                            "const": "fixed",
                            "type": "string"
                          },
                          "value": {
                            "exclusiveMinimum": 0,
                            "type": "number"
                          }
                        }
                      }
                    ]
                  },
                  "tabStops": {
                    "uniqueItems": true,
                    "type": "array",
                    "items": {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    }
                  },
                  "defaultTabInterval": {
                    "exclusiveMinimum": 0,
                    "type": "number"
                  },
                  "numbering": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "listId",
                      "format"
                    ],
                    "properties": {
                      "listId": {
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9._:-]+$",
                        "type": "string"
                      },
                      "format": {
                        "anyOf": [
                          {
                            "const": "decimal",
                            "type": "string"
                          },
                          {
                            "const": "lower-alpha",
                            "type": "string"
                          },
                          {
                            "const": "upper-alpha",
                            "type": "string"
                          },
                          {
                            "const": "bullet",
                            "type": "string"
                          }
                        ]
                      },
                      "start": {
                        "minimum": 1,
                        "maximum": 1000000,
                        "type": "integer"
                      },
                      "suffix": {
                        "maxLength": 16,
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "fragments": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "kind",
                        "text",
                        "origin"
                      ],
                      "properties": {
                        "kind": {
                          "const": "text",
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "styleId": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "origin": {
                          "anyOf": [
                            {
                              "additionalProperties": false,
                              "type": "object",
                              "required": [
                                "kind",
                                "nodeId"
                              ],
                              "properties": {
                                "kind": {
                                  "const": "static",
                                  "type": "string"
                                },
                                "nodeId": {
                                  "minLength": 1,
                                  "type": "string"
                                }
                              }
                            },
                            {
                              "additionalProperties": false,
                              "type": "object",
                              "required": [
                                "kind",
                                "nodeId",
                                "bindingId",
                                "expression",
                                "valueState"
                              ],
                              "properties": {
                                "kind": {
                                  "const": "dynamic-text",
                                  "type": "string"
                                },
                                "nodeId": {
                                  "minLength": 1,
                                  "type": "string"
                                },
                                "bindingId": {
                                  "minLength": 1,
                                  "type": "string"
                                },
                                "expression": {
                                  "type": "string"
                                },
                                "dataPath": {
                                  "type": "string"
                                },
                                "valueState": {
                                  "description": "Missing 与 Null 分别表示。",
                                  "anyOf": [
                                    {
                                      "const": "value",
                                      "type": "string"
                                    },
                                    {
                                      "const": "null",
                                      "type": "string"
                                    },
                                    {
                                      "const": "missing",
                                      "type": "string"
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        },
                        "styleInheritance": {
                          "anyOf": [
                            {
                              "const": "inherit-paragraph",
                              "type": "string"
                            },
                            {
                              "const": "explicit",
                              "type": "string"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "kind",
                        "nodeId",
                        "controlId",
                        "controlType"
                      ],
                      "properties": {
                        "kind": {
                          "const": "input-control",
                          "type": "string"
                        },
                        "nodeId": {
                          "minLength": 1,
                          "maxLength": 256,
                          "pattern": "^[A-Za-z0-9._:-]+$",
                          "type": "string"
                        },
                        "controlId": {
                          "minLength": 1,
                          "maxLength": 256,
                          "pattern": "^[A-Za-z0-9._:-]+$",
                          "type": "string"
                        },
                        "controlType": {
                          "anyOf": [
                            {
                              "const": "text",
                              "type": "string"
                            },
                            {
                              "const": "number",
                              "type": "string"
                            },
                            {
                              "const": "select",
                              "type": "string"
                            },
                            {
                              "const": "date",
                              "type": "string"
                            },
                            {
                              "const": "radio",
                              "type": "string"
                            },
                            {
                              "const": "checkbox",
                              "type": "string"
                            }
                          ]
                        },
                        "placeholder": {
                          "type": "string"
                        },
                        "defaultValue": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "styleId": {
                          "minLength": 1,
                          "maxLength": 256,
                          "pattern": "^[A-Za-z0-9._:-]+$",
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "nodeId",
              "rows"
            ],
            "properties": {
              "kind": {
                "const": "table",
                "type": "string"
              },
              "nodeId": {
                "minLength": 1,
                "type": "string"
              },
              "styleId": {
                "minLength": 1,
                "type": "string"
              },
              "instancePath": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "nodeId",
                    "bindingId",
                    "key",
                    "keyKind",
                    "ordinal"
                  ],
                  "properties": {
                    "nodeId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "bindingId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "keyKind": {
                      "anyOf": [
                        {
                          "const": "path",
                          "type": "string"
                        },
                        {
                          "const": "ordinal",
                          "type": "string"
                        }
                      ]
                    },
                    "ordinal": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "dataPath": {
                      "type": "string"
                    }
                  }
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "kind",
                    "nodeId",
                    "cells"
                  ],
                  "properties": {
                    "kind": {
                      "const": "table-row",
                      "type": "string"
                    },
                    "nodeId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "instancePath": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "nodeId",
                          "bindingId",
                          "key",
                          "keyKind",
                          "ordinal"
                        ],
                        "properties": {
                          "nodeId": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "bindingId": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "key": {
                            "type": "string"
                          },
                          "keyKind": {
                            "anyOf": [
                              {
                                "const": "path",
                                "type": "string"
                              },
                              {
                                "const": "ordinal",
                                "type": "string"
                              }
                            ]
                          },
                          "ordinal": {
                            "minimum": 0,
                            "type": "integer"
                          },
                          "dataPath": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "cells": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "additionalProperties": false,
                        "type": "object",
                        "required": [
                          "kind",
                          "nodeId",
                          "blocks"
                        ],
                        "properties": {
                          "kind": {
                            "const": "table-cell",
                            "type": "string"
                          },
                          "nodeId": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "styleId": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "blocks": {
                            "type": "array",
                            "items": {
                              "$ref": "ResolvedBlock"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "structure": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "conditionals",
        "repeats"
      ],
      "properties": {
        "conditionals": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "nodeId",
              "bindingId",
              "expression",
              "visible",
              "valueState"
            ],
            "properties": {
              "nodeId": {
                "minLength": 1,
                "type": "string"
              },
              "bindingId": {
                "minLength": 1,
                "type": "string"
              },
              "expression": {
                "type": "string"
              },
              "visible": {
                "type": "boolean"
              },
              "valueState": {
                "description": "Missing 与 Null 分别表示。",
                "anyOf": [
                  {
                    "const": "value",
                    "type": "string"
                  },
                  {
                    "const": "null",
                    "type": "string"
                  },
                  {
                    "const": "missing",
                    "type": "string"
                  }
                ]
              },
              "dataPath": {
                "type": "string"
              },
              "instancePath": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "nodeId",
                    "bindingId",
                    "key",
                    "keyKind",
                    "ordinal"
                  ],
                  "properties": {
                    "nodeId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "bindingId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "keyKind": {
                      "anyOf": [
                        {
                          "const": "path",
                          "type": "string"
                        },
                        {
                          "const": "ordinal",
                          "type": "string"
                        }
                      ]
                    },
                    "ordinal": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "dataPath": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "repeats": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "nodeId",
              "bindingId",
              "kind",
              "expression",
              "valueState",
              "instanceCount"
            ],
            "properties": {
              "nodeId": {
                "minLength": 1,
                "type": "string"
              },
              "bindingId": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "anyOf": [
                  {
                    "const": "repeat-block",
                    "type": "string"
                  },
                  {
                    "const": "repeat-row-group",
                    "type": "string"
                  }
                ]
              },
              "expression": {
                "type": "string"
              },
              "valueState": {
                "description": "Missing 与 Null 分别表示。",
                "anyOf": [
                  {
                    "const": "value",
                    "type": "string"
                  },
                  {
                    "const": "null",
                    "type": "string"
                  },
                  {
                    "const": "missing",
                    "type": "string"
                  }
                ]
              },
              "dataPath": {
                "type": "string"
              },
              "instanceCount": {
                "minimum": 0,
                "type": "integer"
              },
              "truncated": {
                "const": true,
                "type": "boolean"
              },
              "instancePath": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "nodeId",
                    "bindingId",
                    "key",
                    "keyKind",
                    "ordinal"
                  ],
                  "properties": {
                    "nodeId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "bindingId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "keyKind": {
                      "anyOf": [
                        {
                          "const": "path",
                          "type": "string"
                        },
                        {
                          "const": "ordinal",
                          "type": "string"
                        }
                      ]
                    },
                    "ordinal": {
                      "minimum": 0,
                      "type": "integer"
                    },
                    "dataPath": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "runtime": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "temporalPolyfillVersion",
        "tzdataSource",
        "tzdataVersion"
      ],
      "properties": {
        "temporalPolyfillVersion": {
          "minLength": 1,
          "type": "string"
        },
        "tzdataSource": {
          "const": "runtime-icu",
          "type": "string"
        },
        "tzdataVersion": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "anyOf": [
            {
              "const": "native",
              "type": "string"
            },
            {
              "const": "legacy-docx-import",
              "type": "string"
            }
          ]
        },
        "templateId": {
          "minLength": 1,
          "type": "string"
        },
        "legacyCommit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      }
    }
  }
}
