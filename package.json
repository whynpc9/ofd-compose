{
  "name": "ofd-compose",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:dotnet": "dotnet test dotnet/OFDCompose.slnx",
    "check:licenses": "node tools/license-check/check-licenses.mjs",
    "smoke": "pnpm test && pnpm test:browser && pnpm test:dotnet"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.3",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "playwright": "1.63.0",
    "tsdown": "0.23.0",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
