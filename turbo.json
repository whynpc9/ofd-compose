{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {},
    "test:browser": {},
    "@ofd-compose/render-worker#test": {
      "dependsOn": ["build", "^test"]
    },
    "@ofd-compose/render-worker#test:browser": {
      "dependsOn": ["^test:browser"]
    }
  }
}
